# ============================================
# Django — Required
# ============================================
SECRET_KEY=django-insecure-change-me-to-a-random-secret-key

# ============================================
# Django — Optional with defaults
# ============================================
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Database — defaults to SQLite
# ============================================
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

