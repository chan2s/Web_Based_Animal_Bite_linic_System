{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Django Backend",
      "type": "shell",
      "command": "python manage.py runserver 0.0.0.0:8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start React Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend/Web_Based_Animal_Bite_linic_System"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Full Stack (Django + React)",
      "dependsOn": ["Start Django Backend", "Start React Dev Server"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Django Migrate",
      "type": "shell",
      "command": "python manage.py migrate",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Django Create Superuser",
      "type": "shell",
      "command": "python manage.py createsuperuser",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Install Backend Dependencies",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend/Web_Based_Animal_Bite_linic_System"
      },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
